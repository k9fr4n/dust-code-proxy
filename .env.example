# Keys that Claude Code will present to the proxy (x-api-key). Comma-separated.
PROXY_API_KEYS=local-proxy-key

# Internal admin endpoints (/internal/*), used by `proxyctl`. Leave empty: the
# proxy then generates a random token into INTERNAL_TOKEN_FILE at startup.
INTERNAL_TOKEN=
INTERNAL_TOKEN_FILE=/data/internal-token
# Base URL proxyctl uses to reach the running server (inside the container).
PROXY_ADMIN_URL=http://127.0.0.1:8080

# --- Dust OAuth (device-code flow, same mechanism as the official CLI) ---
DUST_OAUTH_CLIENT_ID=client_01JGCT55T7FVDG9XF74925R1KT
DUST_CREDENTIAL_FILE=/data/dust-credentials.json
DUST_BASE_URL=https://dust.tt
DUST_SPACE_ID=
# Monthly credit allocation (Free 500 / Pro 8000 / Max 40000 per seat). Used by
# `proxyctl credits` to derive the remaining balance from consumption.
DUST_CREDIT_ALLOWANCE=

# --- Model routing ---
# Fallback agent used when a model name has no entry in models.json.
DUST_DEFAULT_AGENT_CONFIGURATION_ID=
# Path to the model -> agent mapping (JSON).
MODELS_FILE=./models.json
# Prepend the Claude Code `system` field to the Dust message content.
DUST_FORWARD_SYSTEM=true

# --- Client-side MCP tool bridge (step 5) ---
# Server name registered with Dust (5-30 chars).
DUST_MCP_SERVER_NAME=claude-code-proxy
# Heartbeat period in ms (Dust requires <= 5 min; margin applied).
DUST_MCP_HEARTBEAT_INTERVAL_MS=240000
# Reconnect delay for the mcp/requests SSE stream, in ms.
DUST_MCP_RECONNECT_DELAY_MS=5000

# --- Server ---
PORT=8080
LOG_LEVEL=info
